---
import '../styles/global.css';
import { SITE } from '../site.ts';
import { feedbackHref } from '../feedback.ts';
// The one font file the site uses, preloaded so the first paint is already in the final face.
import fontUrl from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD for this page. */
  jsonLd?: Record<string, unknown>;
  /** Ask search engines not to index this page. */
  noindex?: boolean;
}

const { title, description, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title === SITE.name ? `${SITE.name} - ${SITE.tagline}` : `${title} | ${SITE.name}`;
const year = new Date().getFullYear();
const path = Astro.url.pathname;
const isCurrent = (href: string): boolean => (href === '/' ? path === '/' : path.startsWith(href));
// Search Console ownership check: a meta tag only, no tracking script.
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141a21" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${SITE.name} home`}>
          <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
            <rect class="mark-ground" x="1" y="1" width="30" height="30" rx="5" fill="#0d5666"></rect>
            <path class="mark-ink" d="M8.5 16.5l5 5L23.5 10.5" stroke="#ffffff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
            <path class="mark-ink" d="M8.5 26h15" stroke="#ffffff" stroke-opacity="0.55" stroke-width="1.6" stroke-linecap="round"></path>
          </svg>
          {SITE.name}
        </a>
        <nav class="main" aria-label="Main">
          <a href="/#how-it-works">How it works</a>
          <a href="/pricing/" aria-current={isCurrent("/pricing/") ? "page" : undefined}>Pricing</a>
          <a href="/guides/" aria-current={isCurrent("/guides/") ? "page" : undefined}>Guides</a>
          <a href="/faq/" aria-current={isCurrent("/faq/") ? "page" : undefined}>FAQ</a>
          {SITE.repoUrl && <a href={SITE.repoUrl} rel="noopener">Source code</a>}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>&copy; {year} {SITE.name}. Statements are converted in your browser and never uploaded.</p>
        <nav aria-label="Footer">
          <a href="/privacy/">Privacy</a>
          <a href={feedbackHref(Astro.url.pathname)} rel="noreferrer">Feedback</a>
          <a href="/terms/">Terms</a>
          <a href="/faq/">FAQ</a>
          {SITE.supportEmail && <a href={`mailto:${SITE.supportEmail}`}>Contact</a>}
          {SITE.repoUrl && <a href={SITE.repoUrl} rel="noopener">Source code</a>}
        </nav>
      </div>
    </footer>
  </body>
</html>
