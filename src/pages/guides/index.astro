---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { byPriceVisibility } from '../../pricing.ts';

const guides = (await getCollection('guides')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Base title="Guides" description="Step-by-step guides for getting bank statement transactions into Excel, Xero, QuickBooks Online and MYOB.">
  <div class="wrap narrow">
    <h1>Guides</h1>
    <ul class="card-list">
      {
        guides.map((g) => (
          <li>
            <a href={`/guides/${g.data.slug ?? g.id}/`}>
              {g.data.title}
              <span>{byPriceVisibility(g.data.description, g.data.descriptionEarlyAccess ?? g.data.description)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
