---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chevron from '../../components/Chevron.astro';
import Toc from '../../components/Toc.astro';
import { wantsToc } from '../../lib/toc.ts';
import { byPriceVisibility } from '../../pricing.ts';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({ params: { slug: guide.data.slug ?? guide.id }, props: { guide } }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const description = byPriceVisibility(guide.data.description, guide.data.descriptionEarlyAccess ?? guide.data.description);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description,
};
---

<Base title={guide.data.title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/guides/"><Chevron direction="left" />Guides</a>
    </nav>
    <header class="page-head">
      <h1>{guide.data.title}</h1>
    </header>
    <div class:list={['doc', { 'has-toc': wantsToc(headings) }]}>
      <Toc headings={headings} variant="inline" />
      <article class="prose">
        <Content />
        <p class="prose-end"><a class="button" href="/#convert">Convert a statement now</a></p>
      </article>
      <Toc headings={headings} variant="rail" />
    </div>
  </div>
</Base>
