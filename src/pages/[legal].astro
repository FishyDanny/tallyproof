---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Toc from '../components/Toc.astro';
import { SITE } from '../site.ts';
import { wantsToc } from '../lib/toc.ts';
import { byPriceVisibility } from '../pricing.ts';

export async function getStaticPaths() {
  const pages = await getCollection('legal');
  return pages.map((page) => ({ params: { legal: page.id }, props: { page } }));
}

interface Props {
  page: CollectionEntry<'legal'>;
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const description = byPriceVisibility(page.data.description, page.data.descriptionEarlyAccess ?? page.data.description);
---

<Base title={page.data.title} description={description}>
  <div class="wrap">
    <header class="page-head">
      <h1>{page.data.title}</h1>
    </header>
    <div class:list={['doc', { 'has-toc': wantsToc(headings) }]}>
      <Toc headings={headings} variant="inline" />
      <article class="prose">
        <Content />
        {SITE.supportEmail && (
          <p>
            Contact: <a href={`mailto:${SITE.supportEmail}`}>{SITE.supportEmail}</a>
          </p>
        )}
      </article>
      <Toc headings={headings} variant="rail" />
    </div>
  </div>
</Base>
