{
  "name": "tallyproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Convert PDF bank statements to CSV in your browser. Nothing is uploaded; every row is checked against the running balance.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "node --experimental-strip-types scripts/make-fixtures.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm test:e2e",
    "pages:create": "wrangler pages project create tallyproof --production-branch main --force",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name tallyproof --branch main",
    "polar:setup": "node scripts/polar-setup.mjs",
    "export:public": "node scripts/export-public.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.5",
    "pdfjs-dist": "^6.3.289",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "cookie": "^2.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
