# All values are public and end up in the built site. No secrets belong here.
PUBLIC_SUPPORT_EMAIL=
PUBLIC_REPO_URL=
PUBLIC_POLAR_ORG_ID=
# Set to true while testing purchases against sandbox-api.polar.sh
PUBLIC_POLAR_SANDBOX=false
PUBLIC_CHECKOUT_MONTHLY=
PUBLIC_CHECKOUT_YEARLY=
PUBLIC_CHECKOUT_PASS=
# Public address of the site, e.g. https://tallyproof.pages.dev
PUBLIC_SITE_URL=
# Google Search Console "HTML tag" verification token (content value only)
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Cloudflare deploy credentials (wrangler)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
